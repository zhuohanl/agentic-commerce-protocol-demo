{
  "name": "agentic-commerce-protocol",
  "version": "1.0.0",
  "description": "Reference implementation of OpenAI's Agentic Commerce Protocol (ACP)",
  "author": "Locus <info@paywithlocus.com>",
  "contributors": [
    "Eliot Lee"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/locus-technologies/agentic-commerce-protocol-demo"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "demo/mcp-ui-server",
    "demo/merchant",
    "demo/psp",
    "chat-client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "bash ./start-dev.sh",
    "stop": "pkill -9 -f 'tsx' && pkill -9 -f 'vite-node' && pkill -9 -f concurrently && lsof -ti:3000,3001,3112,4000 | xargs kill -9 2>/dev/null || true && docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "get-port": "^7.1.0",
    "sharp": "^0.34.5"
  }
}
